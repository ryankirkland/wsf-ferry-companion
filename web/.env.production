# Loaded by `next build` (NODE_ENV=production); `next dev` never reads it.
# A concrete value here lets the bundler inline DATA_MODE as "live" and
# fold every dev-fixture module out of production chunks - unset, the read
# stays dynamic and fixture code ships. An explicit NEXT_PUBLIC_DATA_MODE
# in the build environment still overrides this file.
NEXT_PUBLIC_DATA_MODE=live
