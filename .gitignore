# Env & secrets - never in git
.env
.env.*
# Next build-time public config - no secrets, must ship with the repo so
# every production build folds dev fixtures the same way (see web/src/config.ts).
!web/.env.production

# Python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# CI-built Lambda artifacts
.build/
*.pyc
.pytest_cache/
.ruff_cache/

# Node / Next.js
node_modules/
.next/
*.tsbuildinfo
out/

# Terraform - state and secrets never in git
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!example.tfvars

# OS / editor
.DS_Store

# Spike artifacts - measurements are captured into the ADR, data is regenerable
spikes/data/
spikes/results/
spikes/.spend.json
